<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        tools:context="com.sysnova.kfg_sales_appv903.Activity.FullViewOrderActivity">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#ffffff"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:layout_marginTop="20dp"
                    android:id="@+id/header_textView"
                    android:text="Order View Panel"
                    android:textSize="25sp"
                    android:backgroundTint="@android:color/holo_blue_bright"
                    android:textColor="@android:color/black"
                    android:gravity="center_horizontal"
                    android:textStyle="bold"
                    />

                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="100">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="40"
                        android:gravity="center"
                        android:text="Product"
                        android:textSize="12sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"></TextView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="10"
                        android:gravity="center"
                        android:text="Uom"
                        android:textSize="12sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"></TextView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="14"
                        android:gravity="center"
                        android:text="Qty"
                        android:textSize="12sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"></TextView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="18"
                        android:gravity="center"
                        android:text="Rate"
                        android:textSize="12sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold">

                    </TextView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="18"
                        android:gravity="center"
                        android:text="Total"
                        android:textSize="12sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"></TextView>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@android:color/black" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/order_product_list_recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </androidx.recyclerview.widget.RecyclerView>

                </LinearLayout>
                <View
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@android:color/black" />

                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="100">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="50"
                        android:gravity="center"
                        android:text="Total"
                        android:textSize="12sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"></TextView>

                    <TextView
                        android:id="@+id/total_bags"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="15"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@android:color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"></TextView>

                    <TextView
                        android:id="@+id/total_price_amt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="35"
                        android:gravity="end"
                        android:text=""
                        android:paddingRight="10dp"
                        android:textColor="@android:color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"></TextView>
                </LinearLayout>


                <LinearLayout
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="35dp"
                    android:weightSum="100"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="35"
                        android:layout_height="wrap_content"
                        android:text="Amount in Words :"
                        android:backgroundTint="@android:color/holo_blue_bright"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        />

                    <TextView
                        android:id="@+id/quantity_words_bags"
                        android:layout_width="0dp"
                        android:layout_weight="65"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:backgroundTint="@android:color/holo_blue_bright"
                        android:textColor="#6a7170"
                        android:textColorHint="#6a7170"
                        android:textColorLink="#6a7170"

                        />
                </LinearLayout>





                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:id="@+id/linear_layout0"
                    android:layout_marginBottom="5dp"
                    android:layout_marginTop="70dp">

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".4"
                        android:layout_marginRight="10dp"
                        android:id="@+id/cancel_button"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/bracgreen"
                        android:text="Back" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/blank_text"
                        android:layout_marginTop="20dp"
                        android:enabled="false"
                        />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </ScrollView>
</ScrollView>