<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_marginTop="10dp"
            android:background="@drawable/square_field"
            android:layout_weight="1"
            android:padding="20dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/serial"
                android:textColor="@color/black"
                android:text="#SL"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight=".1"
                android:layout_gravity="center"
                android:layout_height="wrap_content">
            </TextView>



            <TextView
                android:id="@+id/nameTV"
                android:textColor="@color/black"
                android:text="Product Name"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_weight=".4"
                android:layout_gravity="center"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/minusTV"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:visibility="invisible"
                android:layout_gravity="center"
                android:layout_weight=".1"
                android:src="@drawable/minus" />

            <TextView
                android:id="@+id/qtyTV"
                android:layout_width="0dp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_weight=".1"
                android:textColor="@color/black"
                android:text="QTY" />

            <ImageView
                android:id="@+id/addTV"
                android:layout_width="0dp"
                android:visibility="invisible"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:layout_weight=".1"

                android:src="@drawable/plus" />

            <TextView
                android:id="@+id/totalTV"
                android:layout_width="0dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_weight=".1"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:text="Total" />

            <ImageView
                android:id="@+id/crossTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".1"
                android:visibility="invisible"
                android:src="@android:drawable/ic_menu_close_clear_cancel">
            </ImageView>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            tools:context=".Activities.ProductOrderLine">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:id="@+id/recyclerView"
                android:layout_height="wrap_content">
            </androidx.recyclerview.widget.RecyclerView>

            <LinearLayout
                android:padding="8dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_weight=".6"
                    android:layout_width="0dp"
                    android:text="TOTAL"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:layout_height="wrap_content">
                </TextView>

                <TextView
                    android:text="100"
                    android:id="@+id/listQtySum"
                    android:layout_weight=".1"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/red"
                    android:layout_height="wrap_content">
                </TextView>

                <TextView
                    android:id="@+id/listTotalSum"
                    android:layout_weight=".3"
                    android:layout_width="0dp"
                    android:text="100056"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/red"
                    android:gravity="center"
                    android:layout_height="wrap_content">

                </TextView>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:layout_gravity="center"
                android:id="@+id/addmore_button"
                android:layout_width="wrap_content"
                android:backgroundTint="@color/darkgreen"
                android:textColor="@color/white"
                android:onClick="callAddMoreProducts"
                android:layout_height="wrap_content"
                android:text="Add More Products" />
        </LinearLayout>

        <EditText
            android:padding="8dp"
            android:backgroundTint="@color/bracgreen"
            android:inputType="number"
            android:id="@+id/numET"
            android:textColor="@color/black"
            android:textColorHint="@color/grey"
            android:layout_width="match_parent"
            android:hint="Please Enter Phone Number"
            android:layout_height="wrap_content"/>

        <TableRow
            android:padding="8dp"
            android:id="@+id/tableRow1"
            android:layout_width="fill_parent"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="15dp" >

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="0dp"
                android:layout_weight=".4"
                android:backgroundTint="@color/grey"
                android:textColor="@color/black"
                android:onClick="callCancel"
                android:layout_height="wrap_content"
                android:text="Discard All" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight=".2">
            </TextView>

            <Button
                android:backgroundTint="@color/bracgreen"
                android:id="@+id/confirm_button"
                android:layout_weight=".4"
                android:textColor="#fff"
                android:onClick="callConfirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Confirm" />
        </TableRow>
    </LinearLayout>
</ScrollView>