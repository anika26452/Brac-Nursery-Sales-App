<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="10dp"
    tools:context=".Menu">

    <Button
        android:id="@+id/create_sales_order"
        android:layout_marginTop="50dp"
        android:text="Create Sales Order"
        android:padding="15dp"
        android:backgroundTint="@color/brdarkgreen"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </Button>

    <Button
        android:id="@+id/mortality_btn"
        android:layout_marginTop="10dp"
        android:text="Mortality"
        android:padding="15dp"
        android:backgroundTint="@color/brdarkgreen"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </Button>

    <Button
        android:id="@+id/todays_order"
        android:padding="15dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/brdarkgreen"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="Today's Order"
        android:textAllCaps="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"></Button>

</LinearLayout>